{
  "name": "jawab24-backend",
  "version": "2.0.1",
  "description": "Jawab24 Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && npm run type-check && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check:pg",
    "db:validate": "ts-node scripts/validate-migrations.ts",
    "test": "vitest",
    "precommit": "npm run lint && npm run type-check"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@jawab24/shared": "*",
    "@sentry/node": "^10.35.0",
    "axios": "^1.13.2",
    "bullmq": "^5.66.4",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "fastify": "^4.25.2",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "postgres": "^3.4.3",
    "stripe": "^14.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "drizzle-kit": "^0.20.13",
    "eslint": "^8.56.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^4.5.0",
    "vitest": "^0.34.6"
  }
}
