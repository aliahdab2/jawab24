{
  "name": "jawab24-backend",
  "version": "2.0.1",
  "description": "Jawab24 Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && npm run type-check && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node dist/migrate.js",
    "cache:flush-workspace-settings": "node dist/scripts/flush-workspace-settings-cache.js",
    "cache:warm-replies": "node dist/scripts/warm-reply-cache.js",
    "cache:warm-replies:dev": "tsx src/scripts/warm-reply-cache.ts",
    "seed:plans": "node dist/scripts/seed-plans.js",
    "seed:plans:dev": "npx tsx src/scripts/seed-plans.ts",
    "gdpr:batch-delete": "node dist/scripts/gdpr-batch-delete.js",
    "gdpr:batch-delete:dev": "npx tsx src/scripts/gdpr-batch-delete.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:validate": "ts-node scripts/validate-migrations.ts",
    "admin:add": "ts-node scripts/manage-admin.ts add",
    "admin:remove": "ts-node scripts/manage-admin.ts remove",
    "admin:list": "ts-node scripts/manage-admin.ts list",
    "verify:ga4": "npx tsx scripts/verify-ga4.ts",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:local": "DATABASE_URL=${TEST_DATABASE_URL:-$(../scripts/test-db-url.sh)} vitest run --config vitest.integration.config.ts",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:stress:local": "DATABASE_URL=${TEST_DATABASE_URL:-$(../scripts/test-db-url.sh)} vitest run --config vitest.stress.config.ts",
    "test:coverage": "vitest run --coverage",
    "precommit": "npm run lint && npm run type-check && npm run db:check",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1090.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@jawab24/shared": "*",
    "@sentry/node": "10.56.0",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.4",
    "countries-and-timezones": "^3.9.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "5.8.5",
    "firebase-admin": "^14.2.0",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "libphonenumber-js": "^1.13.0",
    "mammoth": "^1.12.0",
    "openai": "6.27.0",
    "pdf-to-img": "^6.0.0",
    "pdfjs-dist": "5.6.205",
    "postgres": "^3.4.3",
    "prom-client": "^15.1.3",
    "puppeteer-core": "25.9.0",
    "sharp": "0.35.3",
    "stripe": "22.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^3.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
