{
  "name": "jawab24-backend",
  "version": "2.0.1",
  "description": "Jawab24 Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && npm run type-check && tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check:pg",
    "db:validate": "ts-node scripts/validate-migrations.ts",
    "admin:add": "ts-node scripts/manage-admin.ts add",
    "admin:remove": "ts-node scripts/manage-admin.ts remove",
    "admin:list": "ts-node scripts/manage-admin.ts list",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "precommit": "npm run lint && npm run type-check && npm run db:check"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@jawab24/shared": "*",
    "@sentry/node": "^10.35.0",
    "axios": "^1.13.2",
    "bullmq": "^5.66.4",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.29.3",
    "fastify": "^5.7.4",
    "firebase-admin": "^13.6.1",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "openai": "6.21.0",
    "postgres": "^3.4.3",
    "stripe": "^14.11.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.10.6",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.20.13",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
