{
  "name": "jawab24-root",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "ai-worker",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "pre-deploy": "./scripts/pre-deploy-check.sh",
    "check:esm": "grep -E '\"(uuid|node-fetch|chalk|ora|execa|got|globby)\":' backend/package.json && echo '⚠️  ESM-only packages found!' || echo '✅ No ESM-only packages'"
  }
}








