{
  "name": "jawab24-root",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "backend",
    "frontend",
    "ai-worker",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "form-data": "^4.0.6",
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "serialize-javascript": "^7.0.3",
    "vite": "^6.4.3",
    "icu-minify": "^4.9.1",
    "tmp": "^0.2.7",
    "hono": "^4.12.23",
    "qs": "^6.15.2",
    "openai": {
      "ws": "^8.21.0"
    },
    "jsdom": {
      "ws": "^8.21.0"
    },
    "uuid": "^11.1.1",
    "sharp": "^0.35.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces",
    "type-check": "npm run type-check --workspaces --if-present",
    "pre-deploy": "./scripts/pre-deploy-check.sh",
    "check:nginx-routing": "./scripts/check-nginx-routing.sh",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:duplication:baseline": "node scripts/check-duplication.mjs --update-baseline",
    "check:duplication:test": "node --test scripts/__tests__/check-duplication.test.mjs",
    "test:db-tooling": "node --test scripts/__tests__/test-db-url.test.mjs scripts/__tests__/test-db-name.test.mjs",
    "test:build-lock": "node --test scripts/__tests__/build-lock.test.mjs",
    "print:test-db-url": "./scripts/test-db-url.sh",
    "prune:test-dbs": "./scripts/prune-test-dbs.sh",
    "check:openai-sync": "node -e \"const fs=require('fs');const b=JSON.parse(fs.readFileSync('backend/package.json','utf8'));const a=JSON.parse(fs.readFileSync('ai-worker/package.json','utf8'));const bv=b.dependencies&&b.dependencies.openai;const av=a.dependencies&&a.dependencies.openai;const exact=/^\\\\d+\\\\.\\\\d+\\\\.\\\\d+$/;if(!bv||!av){console.error('❌ Missing openai dependency in backend or ai-worker package.json');process.exit(1);}if(!exact.test(bv)||!exact.test(av)){console.error('❌ OpenAI versions must be pinned exact (e.g., 6.21.0, no ^ or ~).');console.error('   backend:',bv);console.error('   ai-worker:',av);process.exit(1);}if(bv!==av){console.error('❌ OpenAI SDK versions are out of sync.');console.error('   backend:',bv);console.error('   ai-worker:',av);process.exit(1);}console.log('✅ OpenAI SDK versions are pinned and in sync at',bv);\"",
    "check:esm": "grep -E '\"(uuid|node-fetch|chalk|ora|execa|got|globby)\":' backend/package.json && echo '⚠️  ESM-only packages found!' || echo '✅ No ESM-only packages'",
    "eval": "npx tsx scripts/playground-eval.ts",
    "test:ecommerce": "npx tsx scripts/ecommerce-integration-test.ts",
    "test:ecommerce:shopify": "PLATFORM=shopify npx tsx scripts/ecommerce-integration-test.ts",
    "test:ecommerce:salla": "PLATFORM=salla npx tsx scripts/ecommerce-integration-test.ts",
    "test:ecommerce:zid": "PLATFORM=zid npx tsx scripts/ecommerce-integration-test.ts",
    "perf:benchmark": "node scripts/perf-benchmark.js",
    "postinstall": "npm run build --workspace=@jawab24/shared",
    "prepare": "husky"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "bash -c 'cd backend && npx eslint --fix \"$@\"' --",
      "bash -c 'cd backend && npx tsc --noEmit'"
    ],
    "ai-worker/src/**/*.ts": [
      "bash -c 'cd ai-worker && npx eslint --fix \"$@\"' --"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npx eslint --fix \"$@\"' --"
    ]
  }
}
