# Server
NODE_ENV=production
PORT=3000
API_URL=https://jawab24.com/api

# Database
# IMPORTANT: Use the same password as in db.env
DATABASE_URL=postgres://postgres:your_secure_password_here@postgres:5432/jawab24

# Redis
# IMPORTANT: Set a strong password in production (used by docker-compose and app)
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# Cookie
# IMPORTANT: Generate a strong random secret (at least 32 characters)
COOKIE_SECRET=your_cookie_secret_here_change_this_to_a_long_random_string

# JWT
# IMPORTANT: Generate a strong random secret (at least 32 characters)
JWT_SECRET=your_jwt_secret_key_here_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Facebook OAuth
# Get these from your Facebook Developer App
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://jawab24.com/auth/callback
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_random_string

# AI Service
AI_SERVICE_URL=http://ai-worker:3002
AI_ENABLED=true
# Shared secret authenticating backend → ai-worker calls. REQUIRED in production
# (>=16 chars) and MUST equal AI_WORKER_SECRET in ai.env. Without it the worker's
# paid OpenAI/Anthropic endpoints could be driven by anyone who can reach them.
# Generate with `openssl rand -hex 32`.
AI_WORKER_SECRET=

# E-commerce Token Encryption (shared by all e-commerce integrations)
# IMPORTANT: Generate with `openssl rand -hex 32` — at least 32 characters
ECOMMERCE_TOKEN_ENCRYPTION_KEY=

# Shopify App (optional — required for Shopify integration)
# Get these from Shopify Partners > Apps > Your App > Settings
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_HOST_NAME=jawab24.com
# App Store URL handle of the listed app — the {app_handle} in the merchant-facing
# plan-management deep link (admin.shopify.com/store/{store}/charges/{app_handle}/pricing_plans).
# Known once the public listing exists; empty hides the deep link in the frontend.
SHOPIFY_APP_HANDLE=

# Salla App (optional — required for Salla integration)
# Get these from portal.salla.partners > My Apps > Your App > App Details
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_HOST_NAME=jawab24.com
SALLA_WEBHOOK_SECRET=

# Zid App (optional — required for Zid integration)
# Get these from the Zid Partner Dashboard > your application.
# ZID_APP_ID = the Partner "Application ID" (webhook subscriptions' original_id).
# ZID_WEBHOOK_SECRET = Basic-auth password for webhook deliveries (min 16 chars);
# the username is fixed in code (services/zid.ts ZID_WEBHOOK_BASIC_USER).
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_APP_ID=
ZID_HOST_NAME=jawab24.com
ZID_WEBHOOK_SECRET=

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL
FRONTEND_URL=https://jawab24.com

# Logging
LOG_LEVEL=info

# Sentry Error Tracking (optional but recommended for production)
# Get your DSN from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
SENTRY_DSN=

# Demo Mode (for testing without Facebook API approval)
# Set to 'true' to enable demo login functionality
DEMO_MODE_ENABLED=false

# Phone OTP Authentication
# Set to 'true' when OTP provider (WhatsApp Cloud API or Vonage SMS) is configured
# When false: phone auth routes are not registered (Facebook login remains the only method)
PHONE_AUTH_ENABLED=false

# WhatsApp connect allowlist (canary gate for the WhatsApp channel)
# Comma-separated emails allowed to connect WhatsApp numbers (Embedded Signup).
# EMPTY/unset = open to all users (full launch). Non-empty = only listed emails
# may connect; everyone else gets WHATSAPP_NOT_ALLOWLISTED (403).
# Runtime var - a backend container restart applies it (no rebuild needed).
# WHATSAPP_ALLOWLIST=founder@example.com

# Vonage SMS — OTP delivery (get keys from dashboard.nexmo.com)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SENDER_ID=Jawab24

# Admin Users
# Comma-separated list of emails that should be auto-promoted to admin on startup
# These users can manually upgrade subscriptions for users in sanctioned regions
ADMIN_EMAILS=admin@example.com

# Resend — transactional email (waitlist campaigns)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@jawab24.com
RESEND_FROM_NAME=Jawab24

# Firebase Cloud Messaging (optional - required for push notifications)
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Minify the JSON to a single line: cat key.json | python3 -c "import sys,json; print(json.dumps(json.load(sys.stdin)))"
FIREBASE_SERVICE_ACCOUNT_KEY=

# Object storage (S3-compatible) — merchant-uploaded images (Post Reply trigger
# images). Provider-agnostic: B2 / R2 / AWS S3 / self-hosted MinIO. Feature stays OFF
# until S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY + S3_PUBLIC_BASE_URL are
# all set. Leave S3_ENDPOINT empty for real AWS S3; set it for B2/R2/MinIO.
# Full setup + provider-switch guide: backend/docs/OBJECT_STORAGE.md
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Per-workspace generous abuse-safety cap in bytes (default 1 GB). Not a normal-use wall.
POST_REPLY_IMAGE_QUOTA_BYTES=1073741824

# On-demand ISR revalidation of the public pricing pages.
#
# /pricing is statically generated with `revalidate: 3600`. Without these two
# vars the backend's revalidation client (src/services/revalidation.ts) takes
# its "not configured" branch on EVERY plan write — admin plan create/update/
# delete, the deploy's seed-plans.ts, and the create-*-prices.ts scripts — so a
# price or quota change stays invisible to merchants for up to a full hour and
# there is no way to push it. It logs a fingerprinted Sentry warning
# ("revalidation-not-configured") rather than failing the write.
#
# FRONTEND_REVALIDATE_URL is deliberately NOT set here. This file is shared by
# both blue and green, and the target is colour-scoped — a colour written here
# is correct on one deploy and silently wrong on the next, which is the same
# invisible staleness this whole mechanism exists to prevent. It is set per
# colour in docker-compose.{blue,green}.yml alongside AI_SERVICE_URL, and
# `environment:` there overrides anything env_file supplies. Pinned by
# backend/test/deployRevalidationUrl.test.ts.
#
# REVALIDATE_SECRET is colour-independent, so it does belong here. It must be
# IDENTICAL to the one in env/frontend.env and is compared with timingSafeEqual
# — any mismatch in length or value is a 401.
REVALIDATE_SECRET=
