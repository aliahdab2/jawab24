# API Configuration
NEXT_PUBLIC_API_URL=https://jawab24.com/api

# Facebook App ID (public - safe to expose)
# Get this from your Facebook Developer App
NEXT_PUBLIC_FB_APP_ID=your_facebook_app_id

# Google Analytics 4 (optional)
# Get this from Google Analytics: Admin > Data Streams > Web > Measurement ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Environment
NODE_ENV=production

# Stripe Publishable Key (public - safe to expose)
# Required for embedded checkout. Get from Stripe Dashboard > Developers > API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Sentry Error Tracking (optional but recommended for production)
# Note: This is public (NEXT_PUBLIC_) - DSN is safe to expose
NEXT_PUBLIC_SENTRY_DSN=

# WhatsApp Embedded Signup configuration ID (public - safe to expose)
# Master switch for the ENTIRE WhatsApp channel UI: unset = WhatsApp surface hidden (dark).
# Created in Meta App Dashboard > WhatsApp > Embedded Signup after App Review approval.
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time - changing this requires a frontend
# rebuild + redeploy (see docs/WHATSAPP_LAUNCH_RUNBOOK.md).
# NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# WhatsApp canary: 'true' = show WhatsApp UI to platform admins only (founder pilot).
# Unset/empty = visible to everyone (once CONFIG_ID is set). Build-time, like above.
# NEXT_PUBLIC_WHATSAPP_CANARY_ADMIN_ONLY=true

# WhatsApp redirect connect: 'true' = /auth/whatsapp/start + full-page navigation.
# Unset/empty = the legacy fb.login popup. Pair with the backend WHATSAPP_CONNECT_REDIRECT.
# NEXT_PUBLIC_WHATSAPP_CONNECT_REDIRECT=true

# Instagram-DIRECT connect (Instagram Login, no Facebook Page): 'true' shows the
# «إنستغرام فقط» option in the channel picker. Unset/empty = dark, and merchants
# see the demand-signal ("register interest") button instead.
#
# Requires ALL of the backend's INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET /
# INSTAGRAM_APP_REDIRECT_URI to be set too — /auth/instagram/start 404s otherwise,
# so turning this on alone yields a button that fails. Those credentials in turn
# require Meta App Review approval of the Instagram Login scopes
# (see .planning/IG_LOGIN_APP_REVIEW.md).
#
# Build-time, like every NEXT_PUBLIC_*: flipping this needs a frontend rebuild +
# redeploy. A container restart does nothing.
# NEXT_PUBLIC_INSTAGRAM_DIRECT_ENABLED=true

# Shared secret for the on-demand ISR revalidation endpoint
# (frontend/src/pages/api/revalidate.ts). MUST be identical to the backend's
# REVALIDATE_SECRET in env/backend.env — the handler compares them with
# timingSafeEqual, so any difference is a 401. Unset = the endpoint returns 500
# "Revalidation is not configured" and the pricing pages only ever refresh when
# their 1-hour ISR window rolls over.
#
# NOT a NEXT_PUBLIC_* var: it is read at request time on the server, so it can
# be changed with a container recreate and does NOT need a frontend rebuild.
REVALIDATE_SECRET=
