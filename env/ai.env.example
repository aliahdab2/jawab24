# OpenAI Configuration
# IMPORTANT: Keep this secret! Never commit the actual key.
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Redis
# IMPORTANT: Must match the REDIS_PASSWORD in backend.env
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@redis:6379

# Server
PORT=3002
NODE_ENV=production

# Shared secret the backend must present (X-AI-Worker-Secret) on every generation
# request. REQUIRED in production (>=16 chars) and MUST equal AI_WORKER_SECRET in
# backend.env. The worker rejects non-/health requests without it (401), so anonymous
# callers / SSRF can't spend AI credits. Generate with `openssl rand -hex 32`.
AI_WORKER_SECRET=

# CORS - restrict to backend origin in production
CORS_ORIGIN=http://backend:3000

# Fallback (when OpenAI is unavailable)
FALLBACK_ENABLED=true

# Sentry Error Tracking (optional but recommended for production)
SENTRY_DSN=
