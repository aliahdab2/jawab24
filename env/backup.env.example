# Backblaze B2 Configuration for Automated Backups
#
# Setup:
#   1. Sign up at https://www.backblaze.com/sign-up/cloud-storage
#   2. Create a bucket named "jawab24-backups" (private)
#   3. Create an application key with read/write access to that bucket
#   4. Copy this file to env/backup.env and fill in the values
#   5. Set a lifecycle rule on the bucket: delete files after 30 days
#
# The backup script (scripts/backup.sh) loads this file automatically.

B2_APPLICATION_KEY_ID=your_key_id_here
B2_APPLICATION_KEY=your_application_key_here
B2_BUCKET_NAME=jawab24-backups
