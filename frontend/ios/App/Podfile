# Resolve @capacitor/ios through Node so npm-workspace hoisting (root vs
# frontend/node_modules) can't break the path.
def capacitor_ios_path
  @capacitor_ios_path ||= File.dirname(Pod::Executable.execute_command('node', ['-p',
    "require.resolve('@capacitor/ios/package.json', { paths: ['#{__dir__}'] })"]).strip)
end

require_relative File.join(capacitor_ios_path, 'scripts/pods_helpers')

platform :ios, '15.0'

use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# temporary directory cleanup for pod install to succeed
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => capacitor_ios_path
  pod 'CapacitorCordova', :path => capacitor_ios_path
end

target 'App' do
  capacitor_pods

  # Firebase Cloud Messaging for push notifications
  pod 'Firebase/Messaging'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
