<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme.
        Edge-to-edge is applied at runtime via Capacitor StatusBar.setOverlaysWebView
        (see frontend/src/pages/_app.tsx). The deprecated values-v29 bar-color
        override was removed in #213 (ignored on API 35+, app targets SDK 36).
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Dark window background so there is no white flash in the gap between
             the splash dismissing and the WebView painting its first frame. -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Pre-API-31 launch theme. Parent MUST stay Theme.SplashScreen (Capacitor
         requirement). The dark layer-list (fixed color + centered logo) replaces
         the old white @drawable/splash; postSplashScreenTheme hands off to the
         dark window background above. API 31+ uses values-v31/styles.xml. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_screen</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>