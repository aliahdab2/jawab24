<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 11+ package visibility requirements for Facebook SDK -->
    <!-- Prevents "cannot call Facebook native apps unless the package visibility needs are declared" -->
    <queries>
        <!-- ⚠️ VIEW+https/http intents are ABSENT here on purpose — for now.
             Without them, Android 11+ package visibility hides every browser
             from AppLauncher.openUrl (queryIntentActivities is filtered), so
             openInSystemBrowser() resolves { completed:false } and degrades to
             a Custom Tab — which swallows Meta's Embedded Signup navigation
             (the WhatsApp connect dead-tap). Declaring https IS the documented
             fix, and v2.0.16 shipped it — but the owner then hit a login loop
             (approve at Facebook → bounced back to /login) and it was reverted
             in v2.0.17 pending a controlled retest.

             Two facts for whoever picks this up (established 2026-07-31):
             - App login does NOT use the Facebook SDK. It is a plain web OAuth
               in a Capacitor Browser tab (login.tsx → dialog/oauth → backend
               /auth/facebook/mobile-callback → 302 to the /auth/app-sync App
               Link below). So an SDK-side login explanation for the loop is
               ruled out.
             - Do NOT hand-add an fbconnect://cct.<applicationId> filter to
               CustomTabActivity: the Facebook SDK (≥5.15) auto-merges exactly
               that filter from its library manifest — it is already in the
               merged manifest.

             Re-adding https must ship as the ONLY change against this baseline
             so a login regression, if it reappears, is attributable. -->

        <!-- Facebook apps (native login / fallback) -->
        <package android:name="com.facebook.katana" />
        <package android:name="com.facebook.lite" />
        <package android:name="com.facebook.orca" />

        <!-- Allow querying for Facebook-related URL schemes used by the SDK -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="fbapi" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="fb-messenger-share-api" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="fbauth2" />
        </intent>
    </queries>
    <application
    android:name=".Jawab24Application"
    android:allowBackup="true"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:supportsRtl="true"
    android:theme="@style/AppTheme"
  >
        <activity
      android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
      android:name=".MainActivity"
      android:label="@string/title_activity_main"
      android:theme="@style/AppTheme.NoActionBarLaunch"
      android:launchMode="singleTask"
      android:exported="true"
      android:windowSoftInputMode="adjustNothing"
    >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth callback: handled by Chrome Custom Tab → web server → com.jawab24.app:// deep link.
                 Do NOT add App Links for /auth/callback — they intercept the redirect before the
                 web server can exchange the code, causing "Error validating verification code". -->

            <!-- Custom URL Scheme: com.jawab24.app:// -->
            <!-- Kept for backwards compatibility with any existing deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.jawab24.app" />
            </intent-filter>

            <!-- App Links: https://jawab24.com/auth/app-sync -->
            <!-- Used by web callback after OAuth code exchange to return to app.
                 android:autoVerify triggers verification against /.well-known/assetlinks.json
                 at install time. When verified, Android opens this app directly and Chrome closes. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="jawab24.com" android:pathPrefix="/auth/app-sync" />
            </intent-filter>
        </activity>

        <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true"
    >
            <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/file_paths"
      />
        </provider>

        <!-- Disable Sentry auto-init; we initialise manually in Jawab24Application -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- Facebook SDK Config -->
        <meta-data
      android:name="com.facebook.sdk.ApplicationId"
      android:value="@string/facebook_app_id"
    />
        <meta-data
      android:name="com.facebook.sdk.ClientToken"
      android:value="@string/facebook_client_token"
    />

        <!-- Facebook Login Activity - REQUIRED for native SDK callback -->
        <activity
      android:name="com.facebook.FacebookActivity"
      android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
      android:label="@string/app_name"
    />

        <!-- Facebook Custom Tab Activity for Chrome Custom Tabs -->
        <activity
      android:name="com.facebook.CustomTabActivity"
      android:exported="true"
    >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/fb_login_protocol_scheme" />
            </intent-filter>
        </activity>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Remove AD_ID permission merged from Firebase / Play Services transitive deps.
         Jawab24 does not use the Android Advertising ID — no AdMob, no Firebase
         Analytics, no Facebook App Events. Required so Play Console "Advertising
         ID declaration" can be answered "No" without a manifest conflict. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
