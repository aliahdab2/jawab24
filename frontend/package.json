{
  "name": "jawab24-frontend",
  "version": "2.1.0",
  "description": "Jawab24 - Smart Facebook Auto-Replies 24/7",
  "private": true,
  "overrides": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "serialize-javascript": "^7.0.3"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "rm -rf .next && npm run lint && next build",
    "build:mobile": "rm -rf .next .next-mobile out && node scripts/build-mobile.js && cp -R .next-mobile out",
    "build:mobile:clean": "rm -rf .next-mobile out && cd android && ./gradlew clean && cd .. && npm run build:mobile && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:release": "rm -rf .next-mobile out && npm run build:mobile && node scripts/strip-mobile-assets.js && npx cap sync android && cd android && ./gradlew bundleRelease",
    "build:ios:payment-guard": "node scripts/neutralize-ios-payment-routes.js",
    "build:ios:payment-guard:test": "node --test scripts/__tests__/neutralize-ios-payment-routes.test.mjs",
    "build:ios:sync": "rm -rf .next-mobile out && npm run build:mobile && node scripts/strip-mobile-assets.js && npm run build:ios:payment-guard && npx cap sync ios",
    "build:ios:open": "npm run build:ios:sync && npx cap open ios",
    "build:ios:clean": "rm -rf .next-mobile out ios/App/App/public/* && npm run build:mobile && node scripts/strip-mobile-assets.js && npm run build:ios:payment-guard && npx cap sync ios",
    "start": "next start -p 3001",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:rules": "node --test \"eslint-rules/**/*.test.mjs\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "translation:validate": "node scripts/validate-translations.js",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:validate": "node scripts/generate-sitemap.js --check && node scripts/validate-sitemap.js",
    "llms:validate": "node scripts/validate-llms.js",
    "llms:validate:test": "node --test scripts/__tests__/validate-llms.test.mjs",
    "social:generate": "npx tsx scripts/generate-social-images.ts",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@capacitor-community/facebook-login": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-audio-recorder": "^8.0.12",
    "@jawab24/shared": "*",
    "@radix-ui/react-popover": "^1.1.15",
    "@sentry/nextjs": "10.56.0",
    "@stripe/react-stripe-js": "6.7.0",
    "@stripe/stripe-js": "9.9.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.0.0",
    "@vercel/og": "^0.11.1",
    "axios": "^1.18.1",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.36.0",
    "gray-matter": "^4.0.3",
    "libphonenumber-js": "1.12.40",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "next-intl": "^4.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.3",
    "sonner": "^1.7.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "axios-mock-adapter": "^2.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.15",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "satori": "0.25.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-rtl": "^0.9.0",
    "tsx": "4.23.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "vitest": "^3.0.0"
  }
}
