.env
.env.*
node_modules/
dist/
build/
.next/
.next-mobile/
.next-dev/
*.log
.DS_Store
.lighthouseci/
data/postgres/*
data/redis/*
!data/.gitkeep
nginx/ssl/*
!nginx/ssl/.gitkeep
nginx/upstream.conf

# Environment files with secrets (keep only .example files)
env/*.env
!env/*.env.example
*.backup
backups/
*.tsbuildinfo
coverage/
frontend/out/
# APK files - should not be in git or bundled in builds
frontend/public/apk/
*.apk

# Firebase config files (contain project secrets)
google-services.json
GoogleService-Info.plist

# Claude Code local settings
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# CocoaPods (generated from Podfile)
frontend/ios/App/Pods/

# Marketing assets (not code)
marketing/

# Android release keys and credentials (NEVER commit)
android-release-keys/
*.keystore
*.jks
seo-indexing-report-*.md

# Local growth/SEO working drafts (kept on disk, not tracked)
/Jawab24_Growth_Playbook.md
/SEO_Audit_Jawab24.md

# GSD local planning/workflow state (per-developer, not shared)
/.planning/
