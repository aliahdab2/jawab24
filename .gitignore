.env
.env.*
node_modules/
dist/
build/
.next/
.next-mobile/
.next-dev/
*.log
.DS_Store
.lighthouseci/
data/postgres/*
data/redis/*
!data/.gitkeep
nginx/ssl/*
!nginx/ssl/.gitkeep
nginx/upstream.conf

# Environment files with secrets (keep only .example files)
env/*.env
!env/*.env.example
*.backup
backups/
*.tsbuildinfo
coverage/
frontend/out/
# APK files - should not be in git or bundled in builds
frontend/public/apk/
*.apk

# Firebase config files (contain project secrets)
google-services.json
GoogleService-Info.plist

# Claude Code local settings
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Exclusive lock held by scripts/pre-deploy-check.sh or scripts/release-android.sh
# while it runs (removed on exit). Both build into frontend/.next.
/.frontend-build.lock/
# Legacy name, kept so an interrupted pre-2026-08-22 run cannot leave a tracked file.
# Ignored so a crashed run can never make deploy-production.sh refuse with
# "You have uncommitted changes".
/.pre-deploy-check.lock/

# CocoaPods (generated from Podfile)
frontend/ios/App/Pods/

# Marketing assets (not code)
marketing/

# Android release keys and credentials (NEVER commit)
android-release-keys/
*.keystore
*.jks
seo-indexing-report-*.md

# Local growth/SEO working drafts (kept on disk, not tracked)
/Jawab24_Growth_Playbook.md
/SEO_Audit_Jawab24.md

# GSD local planning/workflow state (per-developer, not shared)
/.planning/

# Transient baseline copies staged by A/B probes, e.g.
#   git show origin/main:packages/shared/src/businessInfoPrompt.ts \
#     > packages/shared/src/__mainBusinessInfoPrompt.ts
# (scripts/contact-standard-probe.ts). They are verbatim copies of the OTHER
# version, imported so one process can byte-diff both formatters. They must
# never be committed, and never de-duplicated against the file they mirror —
# being a frozen copy IS the point, so `check:duplication` would otherwise
# fail every time someone follows the probe's own instructions.
packages/shared/src/__main*.ts
